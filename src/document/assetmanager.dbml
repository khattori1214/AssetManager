{
    1, 2, `now() - interval '10 days'`, `now() + interval '4 days'`, null
    1, 3, `now() - interval '20 days'`, `now() - interval '6 days'`, `now() - interval '8 days'`
}

Records loan_categories(category_id,category_name,created_at,updated_at,max_loan_days)
{
    1, 'PC',`now()`, `now()`,14
    2, '書籍', `now()`, `now()`,14
    3, '機器',`now()`, `now()`, 30
}

